# RoomRaah — environment variables
# Copy to .env and fill in real values. Never commit a filled-in .env.
# Double underscores map to nested configuration keys in ASP.NET Core.

# --- SQL Server ---
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=RoomRaahDb;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True

# --- Redis (cache, refresh-token revocation, OTP rate limiting) ---
ConnectionStrings__Redis=localhost:6379

# --- Photo storage ---
# Two providers behind one interface. "AzureBlob" is the default and is what
# docker-compose runs through Azurite; "S3" is what an AWS deployment selects.
Storage__Provider=AzureBlob

# AzureBlob: Azurite in development, a real Azure Storage connection string otherwise.
ConnectionStrings__AzureBlob=UseDevelopmentStorage=true

# S3: only read when Storage__Provider is S3.
# Credentials are NOT set here on purpose — the SDK reads the EC2 instance role, so
# no key exists in a file that could be committed or copied off the box.
S3Storage__BucketName=
# Optional. A CloudFront domain or bucket website endpoint. Set it and the stored URLs
# stop naming the bucket, so the bytes can move later without rewriting any rows.
S3Storage__PublicBaseUrl=
# Optional. Only for MinIO or LocalStack; left empty against AWS itself.
S3Storage__ServiceUrl=
S3Storage__ForcePathStyle=false
AWS_REGION=us-east-1

# --- CORS ---
# Every origin the browser client is served from. Named rather than wildcarded,
# because SignalR sends credentials and a wildcard is not allowed with them.
Cors__AllowedOrigins__0=http://localhost:4200

# --- JWT ---
# Key must be at least 32 characters. Generate a fresh one per environment.
JwtSettings__Key=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
JwtSettings__Issuer=RoomRaah.API
JwtSettings__Audience=RoomRaah.Client
JwtSettings__AccessTokenMinutes=30
JwtSettings__RefreshTokenDays=7

# --- Outbound email (OTP, password reset, decision notices) ---
# Mailpit on localhost:1025 in development; a real SMTP host in production.
EmailSettings__Host=localhost
EmailSettings__Port=1025
EmailSettings__UseSsl=false
EmailSettings__UserName=
EmailSettings__Password=
EmailSettings__FromAddress=noreply@roomraah.local
EmailSettings__FromName=RoomRaah
# Base URL of the Angular app; password reset links are built from it.
EmailSettings__FrontendBaseUrl=http://localhost:4200

# --- Photos ---
PhotoSettings__ContainerName=properties
PhotoSettings__MaxFileSizeBytes=5242880
PhotoSettings__MinPhotosPerListing=3
PhotoSettings__MaxPhotosPerListing=15
PhotoSettings__ThumbnailLongEdgePx=400

# --- OTP ---
OtpSettings__CodeLength=6
OtpSettings__ExpiryMinutes=10
OtpSettings__MaxVerifyAttempts=5
OtpSettings__MaxRequestsPerWindow=3
OtpSettings__RequestWindowMinutes=10
OtpSettings__PasswordResetExpiryMinutes=30

# --- Background jobs ---
BackgroundJobs__StaleListingSweepHours=24
BackgroundJobs__StaleListingThresholdDays=30
BackgroundJobs__ExpiredOtpCleanupHours=6
BackgroundJobs__InspectionDueSweepHours=24
BackgroundJobs__InspectionIntervalDays=30

# --- Startup: schema and demo data ---
# Both default to "on in Development, off everywhere else", which is what the code did
# before these existed. They are separate switches because they are separate decisions,
# and a deployment found that out the hard way: running as Production, neither happened,
# so the API came up healthy and then failed every request on a database that had never
# been created.
#
# A real deployment sets MigrateOnStartup true and SeedOnStartup false. The seeders
# write demo accounts whose password is printed in a document — that must never be one
# environment variable away from a live site.
Database__MigrateOnStartup=true
Database__SeedOnStartup=false
